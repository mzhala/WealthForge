<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="5dp"
    tools:context=".BudgetFragment">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <!-- Budget Picker (Month, Year) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="25dp"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Month"
                style="@style/LabelStyle"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Spinner
                android:id="@+id/monthSpinner"
                android:layout_width="86dp"
                android:layout_height="match_parent"
                android:paddingEnd="16dp"
                style="@style/LabelStyle"/>

            <Space
                android:layout_width="12dp"
                android:layout_height="match_parent" />

            <Spinner
                android:id="@+id/yearSpinner"
                android:layout_width="86dp"
                android:layout_height="match_parent"
                android:paddingEnd="16dp"
                style="@style/LabelStyle" />
        </LinearLayout>

        <!-- Budget Amount for Selected (Month, Year)-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/black_card"
            android:orientation="vertical">

            <!-- Category Budget Card Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:background="@drawable/black_card_header">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="Set Selected Month Budget"
                    style="@style/CardTitleStyle" />

            </LinearLayout>

            <!-- Category Limit Amount -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Budget Amount"
                    style="@style/CardLabelStyle" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="184dp"
                    android:layout_height="match_parent"
                    android:padding="1dp"
                    android:background="@drawable/linear_layout_border">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="R"
                        style="@style/LabelStyle" />

                    <EditText
                        android:id="@+id/budgetAmountInput"
                        android:layout_width="140dp"
                        android:layout_height="match_parent"
                        android:hint="0"
                        android:inputType="number"
                        android:imeOptions="actionDone"
                        android:background="@android:color/white"
                        style="@style/Money" />

                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="match_parent" />

            </LinearLayout>
        </LinearLayout>

        <!-- Set/Update Budget Amount Button for Selected (Month, Year)-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/setBudgetAmountButton"
                style="@style/MyButtonStyle"
                android:layout_width="184dp"
                android:layout_height="match_parent"
                android:text="Set Budget Amount" />

        </LinearLayout>

        <!-- Category Budget-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/black_card"
            android:orientation="vertical">

            <!-- Category Budget Card Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:background="@drawable/black_card_header">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="Set Category Limits for the Selected Month Budget"
                    style="@style/CardTitleStyle" />

            </LinearLayout>

            <!-- Category Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category Name"
                    style="@style/CardLabelStyle" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="184dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/white_box">
                    <Spinner
                        android:id="@+id/categorySpinner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingEnd="16dp"
                        style="@style/LabelStyle"/>
                </LinearLayout>


                <Space
                    android:layout_width="12dp"
                    android:layout_height="match_parent" />

        </LinearLayout>

            <!-- Category Limit Amount -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Limit Amount"
                    style="@style/CardLabelStyle" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="184dp"
                    android:layout_height="match_parent"
                    android:padding="1dp"
                    android:background="@drawable/linear_layout_border">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="R"
                        style="@style/LabelStyle" />

                    <EditText
                        android:id="@+id/categoryBudgetAmount"
                        android:layout_width="140dp"
                        android:layout_height="match_parent"
                        android:hint="0"
                        android:inputType="number"
                        android:imeOptions="actionDone"
                        android:background="@android:color/white"
                        style="@style/Money" />

                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="match_parent" />

            </LinearLayout>
        </LinearLayout>
        <!-- Add Category to budget -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/addCategoryToBudgetButton"
                style="@style/MyButtonStyle"
                android:layout_width="184dp"
                android:layout_height="match_parent"
                android:text="Add To Budget" />

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text=": "
                style="@style/LabelStyle"
                android:id="@+id/categories_total"/>

            <View
                android:layout_width="10dp"
                android:layout_height="0dp" />

        </LinearLayout>



        <!-- Categories on budget -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clipToPadding="false"
            android:scrollbars="vertical"
            />
    </LinearLayout>

</ScrollView>
