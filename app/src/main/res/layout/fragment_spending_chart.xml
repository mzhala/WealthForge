<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="0dp"
    android:paddingTop="0dp"
    android:paddingRight="0dp"
    android:paddingBottom="5dp"
    tools:context=".SpendingChartFragment">


    <!-- StartDate (Month, Year) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Date"
            style="@style/LabelStyle"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Spinner
            android:id="@+id/startMonthSpinner"
            android:layout_width="86dp"
            android:layout_height="match_parent"
            android:paddingEnd="16dp"
            style="@style/LabelStyle"/>

        <Space
            android:layout_width="12dp"
            android:layout_height="match_parent" />

        <Spinner
            android:id="@+id/startYearSpinner"
            android:layout_width="86dp"
            android:layout_height="match_parent"
            android:paddingEnd="16dp"
            style="@style/LabelStyle" />
    </LinearLayout>

    <!-- EndDate (Month, Year) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="End Date"
            style="@style/LabelStyle"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Spinner
            android:id="@+id/endMonthSpinner"
            android:layout_width="86dp"
            android:layout_height="match_parent"
            android:paddingEnd="16dp"
            style="@style/LabelStyle"/>

        <Space
            android:layout_width="12dp"
            android:layout_height="match_parent" />

        <Spinner
            android:id="@+id/endYearSpinner"
            android:layout_width="86dp"
            android:layout_height="match_parent"
            android:paddingEnd="16dp"
            style="@style/LabelStyle" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#000000"
        android:layout_marginTop="10dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Budget vs. Actual Spending per Category"
        style="@style/ChartTitleStyle"/>

    <!-- BarChart -->
    <com.github.mikephil.charting.charts.BarChart
        android:id="@+id/categoriesBarChart"
        android:layout_width="match_parent"
        android:layout_height="200dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Budget vs. Actual Spending per Month"
        style="@style/ChartTitleStyle"/>

    <!-- BarChart -->
    <com.github.mikephil.charting.charts.BarChart
        android:id="@+id/monthlyBarChart"
        android:layout_width="match_parent"
        android:layout_height="200dp"/>


</LinearLayout>